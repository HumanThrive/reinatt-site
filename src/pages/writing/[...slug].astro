---
import EngineeringLayout from "../../layouts/EngineeringLayout.astro";
import SiteFoot from "../../components/engineering/SiteFoot.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const showDrafts = !import.meta.env.PROD;
  const posts = (await getCollection("writing", ({ data }) => showDrafts || !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );

  return posts.map((post, idx) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[idx + 1] ?? null,
      next: posts[idx - 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<"writing">;
  prev: CollectionEntry<"writing"> | null;
  next: CollectionEntry<"writing"> | null;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const wordCount = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const postUrl = new URL(`/writing/${post.id}`, Astro.site).toString();

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.excerpt ?? "",
  "datePublished": post.data.date.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.date).toISOString(),
  "author": {
    "@type": "Person",
    "name": "Rei Nuttanon",
    "alternateName": "Rei",
    "url": "https://reinatt.com",
  },
  "publisher": {
    "@type": "Person",
    "name": "Rei Nuttanon",
    "url": "https://reinatt.com",
  },
  "url": postUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
  "inLanguage": "en",
};
---

<EngineeringLayout
  title={`${post.data.title} — Rei Nuttanon`}
  description={post.data.excerpt ?? ""}
  page="writing"
  tone="paper"
  bodyClass="paper"
  ogType="article"
  jsonLd={blogPostingSchema}
>
  <section class="paper writing-page" data-tone="paper">
    <div class="grid">
      <div class="rail">
        <p class="label"><a class="plain" href="/writing/">Writing</a></p>
        <p class="small faint note">
          <time datetime={post.data.date.toISOString()}>{dateFmt(post.data.date)}</time><br />
          {readingMinutes} min read
          {post.data.updatedDate && <><br />Updated {dateFmt(post.data.updatedDate)}</>}
          {post.data.draft && <><br />Draft</>}
        </p>
      </div>
      <article class="body">
        <h1 class="h2 article-title">{post.data.title}</h1>
        <div class="prose">
          <Content />
        </div>
        {
          post.data.originalUrl && (
            <p class="small faint original">
              The original is on <a class="link" href={post.data.originalUrl} rel="noopener">LinkedIn</a>.
            </p>
          )
        }
        {
          (prev || next) && (
            <nav class="post-nav" aria-label="More articles">
              {prev ? (
                <a href={`/writing/${prev.id}`}>
                  <span class="small faint">← Previous</span>
                  <b>{prev.data.title}</b>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a href={`/writing/${next.id}`} class="next">
                  <span class="small faint">Next →</span>
                  <b>{next.data.title}</b>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </article>
    </div>
    <SiteFoot />
  </section>
</EngineeringLayout>
