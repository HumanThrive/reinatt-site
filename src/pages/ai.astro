---
import EngineeringLayout from "../layouts/EngineeringLayout.astro";
import EmailRow from "../components/engineering/EmailRow.astro";
import SiteFoot from "../components/engineering/SiteFoot.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<EngineeringLayout
  title="AI — Rei Nuttanon"
  description="How I work with AI agents on client projects, in two articles."
  page="ai"
  tone="ink"
>

  <section class="sec ink hero lucy-hero" data-tone="ink">
    <div class="grid">
      <div class="rail"><p class="label fade">AI</p><p class="label faint fade">Integration · governance</p></div>
      <div class="body">
        <h1 class="h1 fade">How I work with AI agents.</h1>
        <p class="lead fade d1">I use a team of AI agents on client projects. These two articles explain how I set them up, and what keeps their work dependable.</p>
      </div>
    </div>
  </section>

  <section class="sec paper" data-tone="paper">
    <div class="grid rule">
      <div class="rail"><p class="label"><span class="idx">01</span>Featured articles</p></div>
      <div class="body">
        <h2 class="h2 fade">Read how it works.</h2>
        <ol class="ways">
          {
            articles.map((a, i) => (
              <li class={`fade${i ? ` d${Math.min(i, 3)}` : ""}${a.data.cover ? " has-cover" : ""}`}>
                {a.data.cover && (
                  <a class="ways-cover" href={`/writing/${a.id}`} tabindex="-1" aria-hidden="true">
                    <img src={a.data.cover} alt="" width="1280" height="720" loading="lazy" decoding="async" />
                  </a>
                )}
                <span class="t">
                  <a class="link" href={`/writing/${a.id}`}>{a.data.title}</a>
                </span>
                <span class="d">
                  {a.data.excerpt} <span class="faint">{dateFmt(a.data.date)}.</span>{" "}
                  <a class="link" href={`/writing/${a.id}`}>Read the article →</a>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="sec paper contact" id="contact" data-tone="paper">
    <div class="grid rule">
      <div class="rail"><p class="label"><span class="idx">02</span>Contact</p></div>
      <div class="body">
        <h2 class="h1 fade">I can show it running.</h2>
        <EmailRow />
        <p class="dim mt fade d2">Ten minutes, on a call.</p>
        <p class="links mt-l fade d3"><a class="link" href="/">Back to the start →</a><a class="link" href="/cv/">CV →</a></p>
      </div>
    </div>
    <SiteFoot />
  </section>
  <div class="toast" role="status" aria-live="polite" slot="after-main"></div>
</EngineeringLayout>
