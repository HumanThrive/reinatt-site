---
import EngineeringLayout from "../layouts/EngineeringLayout.astro";
import CoverSprite from "../components/engineering/CoverSprite.astro";
import WorkList from "../components/engineering/WorkList.astro";
import CaseSheets from "../components/engineering/CaseSheets.astro";
import EmailRow from "../components/engineering/EmailRow.astro";
import SiteFoot from "../components/engineering/SiteFoot.astro";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rei Nuttanon",
  jobTitle: "Senior Full-Stack Engineer",
  url: "https://reinatt.com/",
  sameAs: ["https://www.linkedin.com/in/reinuttanon/", "https://github.com/reinuttanon"],
};
---

<EngineeringLayout
  title="Rei Nuttanon — Engineering"
  description="Senior full-stack engineer. I build AI into the software businesses run on, and design the guardrails that keep it reliable."
  page="home"
  tone="ink"
  jsonLd={person}
>
  <CoverSprite slot="before-header" />

  <section class="sec ink hero" data-tone="ink">
    <div class="grid">
      <div class="rail"><p class="label fade">Senior full-stack engineer</p><p class="label faint fade">AI integration</p><p class="label faint fade">AI agent governance</p><p class="label faint fade">Bangkok · UTC+7</p></div>
      <div class="body">
        <h1 class="h1 fade">I build AI into the software businesses run on.</h1>
        <p class="lead fade d1">Engineer since 2011, across e-commerce, payments and operations software. Now I work out where AI helps a business, build it into the software, and make sure it's safe to rely on.</p>
        <p class="aside-note fade d2"><span class="sq" aria-hidden="true"></span>Yes, this site is built by my AI agents too. <a class="link" href="/ai/">How it works →</a></p>
      </div>
    </div>
  </section>

  <section class="sec ink" data-tone="ink" style="padding-top:0">
    <div class="grid rule">
      <div class="rail"><p class="label"><span class="idx">01</span>AI</p></div>
      <div class="body">
        <h2 class="h2 fade">AI integration and agent governance.</h2>
        <ol class="ways">
          <li class="fade"><span class="t">In products</span><span class="d">I built an on-device app for a factory that reads a machine's display and checks each reading, using a model I trained myself. <a class="link" href="#case-vision" data-case="vision">The factory case →</a></span></li>
          <li class="fade"><span class="t">In my own work</span><span class="d">I designed the system my AI agents work inside, and I use it to deliver client work every day. <a class="link" href="/ai/#rules">How I govern it →</a></span></li>
          <li class="fade"><span class="t">In operations</span><span class="d">I build the software a business's operations run on, with AI in the build, and I help the team run AI on their own machines.</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="sec paper" data-tone="paper">
    <div class="grid rule">
      <div class="rail"><p class="label"><span class="idx">02</span>Approach</p></div>
      <div class="body">
        <h2 class="h2 fade">I start with people, not code.</h2>
        <ol class="list">
          <li class="fade"><span class="n">1</span><span>I sit with the people who run it.</span></li>
          <li class="fade d1"><span class="n">2</span><span>I find where the work gets stuck.</span></li>
          <li class="fade d2"><span class="n">3</span><span>I redesign how the work gets done, and take part in the decision.</span></li>
          <li class="fade d3"><span class="n">4</span><span>I build it, and stay until the team runs on it.</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="sec paper" id="work" data-tone="paper" style="padding-top:0">
    <div class="grid rule">
      <div class="rail"><p class="label"><span class="idx">03</span>Selected work</p><p class="small faint note">Six works, 2013 to now. Open one for the story.</p></div>
      <div class="body"><WorkList /></div>
    </div>
    <div class="cover-follow" aria-hidden="true"></div>
  </section>

  <section class="sec paper contact" id="contact" data-tone="paper">
    <div class="grid rule">
      <div class="rail"><p class="label"><span class="idx">04</span>Contact</p></div>
      <div class="body">
        <h2 class="h1 fade">Let's talk.</h2>
        <EmailRow />
        <p class="dim mt fade d2">Based in Bangkok. Working remotely since 2020, with teams in any time zone.</p>
        <p class="links mt-l fade d3"><a class="link" href="https://www.linkedin.com/in/reinuttanon/" target="_blank" rel="noopener">LinkedIn ↗</a><a class="link" href="https://github.com/reinuttanon" target="_blank" rel="noopener">GitHub ↗</a><a class="link" href="/cv/">CV →</a></p>
      </div>
    </div>
    <SiteFoot />
  </section>
  <Fragment slot="after-main">
    <CaseSheets />
    <div class="toast" role="status" aria-live="polite"></div>
  </Fragment>
</EngineeringLayout>
