---
// The CV. The <article> below is a verbatim copy of the accepted CV in the Lucy repository
// (work-394, cv/cv.html), so a later revision of that CV is applied by pasting its <article> here.
import EngineeringLayout from "../layouts/EngineeringLayout.astro";
---

<EngineeringLayout
  title="CV — Rei Nuttanon"
  description="The CV of Rei Nuttanon, senior full-stack engineer: AI integration and agent governance, experience, open source and skills."
  page="cv"
  tone="paper"
  bodyClass="paper"
>
  <section class="paper cv-page" data-tone="paper">
    <div class="grid">
      <div class="rail"><p class="label">CV</p><p class="small faint note">Prints to A4. Choose “Save as PDF” in the print dialog.</p></div>
      <article class="body cv">
        <div class="cv-actions"><span class="small faint">Updated October 2026</span><button type="button" data-print>Download as PDF</button></div>
        <header class="cv-head">
          <h1>Rei Nuttanon</h1>
          <p class="role">Senior Full-Stack Engineer. AI integration and agent governance.</p>
          <p class="contact-line"><span>Bangkok, Thailand (UTC+7)</span><a href="mailto:reinuttanon@gmail.com">reinuttanon@gmail.com</a><a href="https://reinatt.com">reinatt.com</a><a href="https://www.linkedin.com/in/reinuttanon/">linkedin.com/in/reinuttanon</a><a href="https://github.com/reinuttanon">github.com/reinuttanon</a></p>
        </header>
        <section class="cv-block"><p class="label">Summary</p><p class="summary">Built software professionally since 2011, across the full stack. Remote since 2020. Now building production software with AI agents, and designing the AI-governance architecture around them. Nearly 9 years in online payments and e‑commerce. I translate my years of experiences into AI agents and build the AI workflow that can ship things to production.</p></section>
        <section class="cv-block"><p class="label">Experience</p><div class="cv-role"><div class="r1"><h3>Independent Software and Business Consultant</h3><span class="when">Jan 2025 – Present</span></div><div class="where">Bangkok, Thailand · remote</div><ul><li>Provide consulting to business owners on the operation itself: initiate ideas, redesign how the work gets done to raise productivity and cut working time, and take part in the business decisions that involve tech. Then build the systems, and get the team running on them.</li></ul><div class="cv-sub"><div class="r1"><h4>Online marketing operations platform (confidential)</h4><span class="when">Jan 2025 – Present</span></div><ul><li>Designed and built the platform for agencies and media buyers: a back office and tools for its operators, a customer app that runs inside LINE (LIFF) and on the web, and the API behind them.</li><li>Built the wallet and billing core: a prepaid wallet on a replayable ledger, with bank-transfer top-ups, usage charges, reversals and a reconciliation import. Charges are safe to retry, so a request that times out never charges twice.</li><li>Built the affiliate program: referral commissions earned on paid top-ups, settled monthly, then paid out or converted to credit.</li><li>Automated the daily data reconciliation the operators did by hand, from hours to a minute, and built tools for the rest of their daily work.</li><li>Advised the team on running AI on their own machines.</li><li>Laravel 11, PHP 8.2, PostgreSQL, Nuxt 4, Vue 3, TypeScript, Pinia, Tailwind, Docker, Cloudflare Workers.</li></ul></div><div class="cv-sub"><div class="r1"><h4>Lucy, my own AI agent system</h4><span class="when">Jul 2026 – Present</span></div><ul><li>Designed and built a team of AI agents on Claude Code that plan, write and review production code in parallel.</li><li>Runs my client delivery, including the platform above.</li></ul></div><div class="cv-sub"><div class="r1"><h4>Factory computer vision (confidential)</h4><span class="when">Mar – Aug 2025</span></div><ul><li>Built an on-device computer-vision app that reads a machine’s display and checks each reading automatically, using a model I trained myself.</li><li>Python, PyTorch, OpenCV, YOLO, EasyOCR.</li></ul></div></div><div class="cv-role"><div class="r1"><h3>Founder, morei.vn</h3><span class="when">2024</span></div><div class="where">Ho Chi Minh City, Vietnam · remote</div><ul><li>Designed and built a platform that matches actors to casting work.</li><li>Ran the business side too: reached out to hundreds of actors and to entertainment job agencies, pitched and sold the platform, onboarded both sides, matched talent to jobs, and handled the work between agencies and talent.</li></ul></div><div class="cv-role"><div class="r1"><h3>Full Stack Developer, Hivelocity</h3><span class="when">Jul 2021 – Mar 2024</span></div><div class="where">Tokyo, Japan · remote</div><ul><li>Built and maintained two product lines for a Japanese entertainment-tech company.</li><li>Developed and extended the EC-CUBE platform behind music artists’ fan-club stores: merchandise, memberships and gacha.</li><li>Built the sites for IP-licensed pop-up cafés (Hello Kitty and similar) on WordPress and WooCommerce.</li><li>Built the sales reporting and the data imports the business ran on.</li></ul></div><div class="cv-role"><div class="r1"><h3>Full Stack Engineer (Contract), SamePage Inc.</h3><span class="when">Nov 2020 – Jun 2021</span></div><div class="where">Tokyo, Japan · remote</div><ul><li>Customized and built e‑commerce websites on EC-CUBE for the company’s clients, as an embedded member of a Japanese-speaking team.</li></ul></div><div class="cv-role"><div class="r1"><h3>Developer, Integrations, Omise</h3><span class="when">Apr 2015 – Aug 2020</span></div><div class="where">Bangkok, Thailand</div><ul><li>Built and maintained the public payment plugins and libraries for WooCommerce, Magento, OpenCart and PHP.</li><li>Supported merchants directly on integration issues.</li></ul></div><div class="cv-role"><div class="r1"><h3>Earlier roles</h3><span class="when">Dec 2011 – Mar 2015</span></div><div class="where">Bangkok, Thailand</div><ul><li>Web developer and PHP programmer at VBT Communications, Diversition, Cubic Creative and OneCallAsia. Built a provident fund module for Siam Commercial Bank.</li></ul></div></section>
              <section class="cv-block"><p class="label">Open source</p><div class="cv-cols"><p class="cv-line"><b>omise-woocommerce</b>: #1 all-time contributor. 2,000+ active installs.</p><p class="cv-line"><b>omise-magento</b>: #2 all-time contributor.</p><p class="cv-line"><b>omise-opencart</b>: #1 all-time contributor.</p><p class="cv-line"><b>omise-php</b>: #2 all-time contributor.</p></div><p class="cv-line cv-note">Contributed as <a href="https://github.com/guzzilar">github.com/guzzilar</a>, my earlier GitHub account.</p></section>
        <section class="cv-block"><p class="label">Skills</p><div class="cv-cols"><p class="cv-line"><b>AI:</b> Claude Code, multi-agent orchestration, agent governance, computer vision (YOLO, EasyOCR, PyTorch, OpenCV)</p><p class="cv-line"><b>Languages:</b> PHP, TypeScript, JavaScript, Python, SQL</p><p class="cv-line"><b>Back end:</b> Laravel, REST APIs, queues and background jobs, Node.js</p><p class="cv-line"><b>Front end:</b> Nuxt, Vue, Next.js, React, Pinia, Tailwind</p><p class="cv-line"><b>Payments and commerce:</b> payment gateway integration, prepaid wallets and ledgers, WooCommerce, Magento, OpenCart, EC-CUBE, WordPress</p><p class="cv-line"><b>Data and platforms:</b> PostgreSQL, MySQL, LINE LIFF, Docker, Cloudflare Workers, Git, Raspberry Pi</p><p class="cv-line"><b>Industries:</b> payments, e‑commerce, online marketing, entertainment</p></div></section>
        <section class="cv-block"><p class="label">Languages</p><p class="cv-line">English (fluent) · Thai (native) · Vietnamese (conversational) · Japanese (conversational)</p></section>
      </article>
    </div>
  </section>
  <script>
    import "../scripts/engineering/cv-print";
  </script>
</EngineeringLayout>
