---
// The shell of the engineering site: the home page, /ai/ and /cv/.
// The older routes (/about, /now, /work, /writing) keep Layout.astro and its Tailwind styles.
import "../styles/engineering-fonts.css";
import "../styles/engineering.css";
import SiteHeader from "../components/engineering/SiteHeader.astro";
import type { Page } from "../components/engineering/page";

interface Props {
  title: string;
  description: string;
  page: Page;
  /** The tone of the page's first section. The header and the browser's theme colour follow it. */
  tone: "ink" | "paper";
  bodyClass?: string;
}

const { title, description, page, tone, bodyClass } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const themeColor = tone === "ink" ? "#141416" : "#F2EFE9";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rei Nuttanon" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* This script runs before first paint, so the elements that fade in are hidden before they can flash.
        If the page's scripts have not set RN_READY within two seconds, the page shows everything unanimated. */}
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!window.RN_READY){document.documentElement.classList.remove('js');}},2000);</script>
  </head>
  <body data-page={page} class={bodyClass}>
    <slot name="before-header" />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader page={page} tone={tone} />
    <main id="main">
      <slot />
    </main>
    <slot name="after-main" />
    <script>
      import "../scripts/engineering/reveal";
    </script>
  </body>
</html>
